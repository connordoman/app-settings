{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react", "react-dom"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // The registry source is authored under the `@/registry` prefix, exactly as
    // the shadcn CLI expects to find it before it rewrites imports to the
    // consumer's own aliases. See README "How imports are rewritten".
    "paths": {
      "@/registry/*": ["./registry/*"],
      "@/components/ui/*": ["./stubs/ui/*"],
      "@/lib/utils": ["./stubs/utils.ts"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["registry", "scripts", "test", "stubs"]
}
