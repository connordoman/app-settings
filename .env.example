# Copy to .env and adjust. Only SETTINGS_DATABASE_URL is required.

# PostgreSQL. The standard PG* variables work too.
SETTINGS_DATABASE_URL=postgres://settings:settings@localhost:5433/settings?sslmode=disable

# Optional: enables the resolution cache. Leave unset to run without Redis.
SETTINGS_REDIS_URL=redis://localhost:6380/0
SETTINGS_CACHE_TTL=60s

SETTINGS_LISTEN_ADDR=:8080

# Apply embedded migrations at boot. Turn off if you migrate separately.
SETTINGS_AUTO_MIGRATE=true

# CIDRs whose X-Forwarded-For header is trusted. Empty trusts none, which is
# correct unless the server sits behind a proxy you control.
SETTINGS_TRUSTED_PROXIES=

SETTINGS_DEBUG=false
